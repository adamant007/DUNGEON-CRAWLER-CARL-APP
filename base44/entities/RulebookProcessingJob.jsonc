{
  "name": "RulebookProcessingJob",
  "type": "object",
  "properties": {
    "rulebook_id": {
      "type": "string",
      "default": ""
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "extracting",
        "extraction_complete",
        "failed"
      ],
      "default": "queued"
    },
    "stage": {
      "type": "string",
      "enum": [
        "upload",
        "text_extraction",
        "complete"
      ],
      "default": "upload"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "error_message": {
      "type": "string",
      "default": ""
    },
    "processing_version": {
      "type": "number",
      "default": 1
    },
    "schema_version": {
      "type": "number",
      "default": 1
    }
  },
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  },
  "required": [
    "rulebook_id"
  ]
}